---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Skilldotpy - Free NIELIT O Level & CCC Preparation Platform"
  description="Learn more about Skilldotpy, founded by Mr. Aditya Pathak to provide high quality, free NIELIT O Level (R5.1) and CCC notes, practicals and CBT mock tests across India."
  keywords={["About Skilldotpy", "Aditya Pathak NIELIT", "Skilldotpy mission", "Free O Level education"]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-white border border-slate-200 rounded-2xl p-8 sm:p-12 shadow-xs">
      <span class="px-3 py-1 bg-blue-100 text-blue-800 text-xs font-bold rounded-full inline-block mb-3">Our Mission</span>
      <h1 class="text-3xl font-extrabold text-slate-900 mb-4">Empowering Every NIELIT Aspirant Across India</h1>
      <p class="text-sm text-slate-600 leading-relaxed mb-6">
        Skilldotpy was founded by <strong>Mr. Aditya Pathak</strong> with a single vision: to eliminate expensive coaching fees and make world-class NIELIT O Level (M1 to M4) and CCC preparation accessible to every student in Hindi and English.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-8">
        <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl text-center">
          <span class="text-2xl font-black text-blue-600 block">100%</span>
          <span class="text-xs text-slate-600 font-medium">Free Study Content</span>
        </div>
        <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl text-center">
          <span class="text-2xl font-black text-emerald-600 block">Grade S/A</span>
          <span class="text-xs text-slate-600 font-medium">Target Exam Grades</span>
        </div>
        <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl text-center">
          <span class="text-2xl font-black text-amber-600 block">R5.1</span>
          <span class="text-xs text-slate-600 font-medium">Latest NSQF Level 4</span>
        </div>
      </div>

      <h2 class="text-xl font-bold text-slate-900 mt-8 mb-3">What We Provide</h2>
      <ul class="space-y-2 text-xs sm:text-sm text-slate-700 list-disc list-inside">
        <li>Comprehensive chapter-wise theory notes with LibreOffice and Python practical diagrams.</li>
        <li>Online timed Computer Based Test (CBT) engine mirroring official NIELIT exams.</li>
        <li>Interactive Python programming and web development practical practice labs.</li>
        <li>Direct PDF downloads of official syllabus, model question papers, and shortcut keys.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
