---
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200 text-slate-800 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-hidden">
      <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white font-black text-xl shadow-md group-hover:bg-blue-700 transition">
        S
      </div>
      <div>
        <span class="text-xl font-bold tracking-tight text-slate-900">Skilldotpy<span class="text-blue-600">.com</span></span>
        <p class="text-xs text-slate-500 font-medium hidden sm:block">NIELIT O Level & CCC Preparation</p>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 font-medium text-sm text-slate-700">
      <a
        href="/o-level"
        class={`px-3 py-2 rounded-lg transition ${currentPath.startsWith('/o-level') ? 'bg-blue-50 text-blue-700 font-semibold' : 'hover:bg-slate-100'}`}
      >
        O Level (M1-M4)
      </a>
      <a
        href="/ccc"
        class={`px-3 py-2 rounded-lg transition ${currentPath.startsWith('/ccc') ? 'bg-blue-50 text-blue-700 font-semibold' : 'hover:bg-slate-100'}`}
      >
        CCC
      </a>
      <a
        href="/notes/m1-r5-ch1-introduction-to-computer"
        class={`px-3 py-2 rounded-lg transition ${currentPath.startsWith('/notes') ? 'bg-blue-50 text-blue-700 font-semibold' : 'hover:bg-slate-100'}`}
      >
        Notes & Chapters
      </a>
      <a
        href="/mock-test"
        class={`px-3 py-2 rounded-lg transition ${currentPath.startsWith('/mock-test') ? 'bg-blue-50 text-blue-700 font-semibold' : 'hover:bg-slate-100'}`}
      >
        Online Mock Test
      </a>
      <a
        href="/resources"
        class={`px-3 py-2 rounded-lg transition ${currentPath.startsWith('/resources') ? 'bg-blue-50 text-blue-700 font-semibold' : 'hover:bg-slate-100'}`}
      >
        PDF Downloads
      </a>
    </nav>

    <!-- Right Call to Action Buttons -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href="/app"
        class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-slate-300 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition"
      >
        <span>📱 Mobile App</span>
      </a>
      <a
        href="/mock-test"
        class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs sm:text-sm font-semibold shadow-sm transition"
      >
        Start Free Test
      </a>
    </div>
  </div>

  <!-- Mobile Secondary Scrollable Subnav -->
  <div class="md:hidden flex items-center gap-2 px-4 py-2 border-t border-slate-100 overflow-x-auto text-xs font-medium scrollbar-none">
    <a href="/o-level" class="shrink-0 px-3 py-1.5 rounded-full bg-slate-100 text-slate-700">O-Level</a>
    <a href="/ccc" class="shrink-0 px-3 py-1.5 rounded-full bg-slate-100 text-slate-700">CCC</a>
    <a href="/notes/m1-r5-ch1-introduction-to-computer" class="shrink-0 px-3 py-1.5 rounded-full bg-slate-100 text-slate-700">Notes</a>
    <a href="/mock-test" class="shrink-0 px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 font-semibold">CBT Test</a>
    <a href="/resources" class="shrink-0 px-3 py-1.5 rounded-full bg-slate-100 text-slate-700">PDFs</a>
  </div>
</header>
