---
export interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  canonicalUrl?: string;
  ogImage?: string;
  articleDate?: string;
  type?: 'website' | 'article' | 'course';
}

const {
  title = 'Skilldotpy - #1 NIELIT O Level & CCC Free Notes, Courses & CBT Practice',
  description = 'India’s leading free learning portal for NIELIT O Level (M1-R5.1 to M4-R5.1) and CCC examinations. Free notes, chapter PDFs, online mock tests, and Python practical labs.',
  keywords = [
    'NIELIT O Level notes',
    'NIELIT CCC syllabus pdf',
    'M1-R5.1 IT Tools',
    'M2-R5.1 Web Design',
    'M3-R5.1 Python Programming',
    'M4-R5.1 IoT',
    'LibreOffice Calc shortcuts',
    'Skilldotpy',
    'Aditya Pathak NIELIT',
  ],
  canonicalUrl = Astro.url.href,
  ogImage = 'https://skilldotpy.com/skilldotpy-logo.svg',
  articleDate,
  type = 'website',
} = Astro.props;

const siteUrl = 'https://skilldotpy.com';
const fullCanonical = canonicalUrl.startsWith('http') ? canonicalUrl : `${siteUrl}${canonicalUrl}`;
---

<!-- Core Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords.join(', ')} />
<meta name="author" content="Mr. Aditya Pathak - Skilldotpy" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="application-name" content="Skilldotpy" />
<meta name="apple-mobile-web-app-title" content="Skilldotpy" />
<meta name="geo.region" content="IN" />
<meta name="geo.placename" content="India" />

<!-- Canonical -->
<link rel="canonical" href={fullCanonical} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={fullCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content="Skilldotpy" />
<meta property="og:locale" content="en_IN" />
<meta property="og:locale:alternate" content="hi_IN" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@skilldotpy" />
<meta name="twitter:creator" content="@skilldotpy" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Favicon & Icons -->
<link rel="icon" type="image/svg+xml" href="/skilldotpy-logo.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://skilldotpy.com/#website",
      "url": "https://skilldotpy.com",
      "name": "Skilldotpy",
      "description": "NIELIT O Level and CCC Complete Preparation Platform",
      "publisher": {
        "@type": "EducationalOrganization",
        "name": "Skilldotpy",
        "url": "https://skilldotpy.com",
        "logo": "https://skilldotpy.com/skilldotpy-logo.svg"
      }
    },
    {
      "@type": "EducationalOrganization",
      "@id": "https://skilldotpy.com/#organization",
      "name": "Skilldotpy",
      "url": "https://skilldotpy.com",
      "logo": "https://skilldotpy.com/skilldotpy-logo.svg",
      "founder": {
        "@type": "Person",
        "name": "Aditya Pathak"
      }
    }
  ]
})} />
