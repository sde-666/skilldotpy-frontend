---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="NIELIT CCC Course on Computer Concepts Complete Guide & Free Notes | Skilldotpy"
  description="All-in-one preparation guide for NIELIT CCC examination: Official syllabus, LibreOffice Calc/Writer shortcuts, online test series, previous year questions, and Grade S strategy."
  keywords={[
    "NIELIT CCC syllabus pdf",
    "CCC online mock test free",
    "LibreOffice Calc shortcut keys",
    "LibreOffice Writer shortcut keys for CCC",
    "CCC exam pattern and passing marks",
    "BHIM UPI USSD full form CCC",
    "Skilldotpy CCC"
  ]}
  type="course"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <span class="px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full inline-block mb-3">
        NIELIT Certificate Course
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        Course on Computer Concepts (CCC)
      </h1>
      <p class="text-sm text-slate-600 leading-relaxed">
        Qualify government job requirements (UPSSSC, VDO, Lekhpal, Banking, Police) with Grade S/A in your first attempt.
      </p>
    </div>

    <!-- Quick Highlights -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10 text-center">
      <div class="p-4 bg-white border border-slate-200 rounded-xl shadow-xs">
        <span class="text-2xl font-black text-slate-900 block">100</span>
        <span class="text-xs text-slate-500 font-medium">MCQ Questions</span>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded-xl shadow-xs">
        <span class="text-2xl font-black text-slate-900 block">90 Min</span>
        <span class="text-xs text-slate-500 font-medium">Exam Duration</span>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded-xl shadow-xs">
        <span class="text-2xl font-black text-emerald-600 block">0</span>
        <span class="text-xs text-slate-500 font-medium">Negative Marks</span>
      </div>
      <div class="p-4 bg-white border border-slate-200 rounded-xl shadow-xs">
        <span class="text-2xl font-black text-blue-600 block">50%</span>
        <span class="text-xs text-slate-500 font-medium">Minimum Pass (Grade D)</span>
      </div>
    </div>

    <!-- Notes & Shortcut Keys Card -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs mb-8">
      <h2 class="text-xl font-bold text-slate-900 mb-3">
        📖 CCC Chapter Notes & Master Shortcut Keys
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">
        Read comprehensive chapter-by-chapter notes covering Introduction to GUI OS, LibreOffice Writer word processing, Calc spreadsheet formulas, Impress presentations, Internet concepts, Email etiquette, Digital Financial Services, and Cyber Security laws.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="/notes/ccc-ch1-introduction-to-computer-gui-os"
          class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-xs transition"
        >
          Read CCC Complete Notes & Shortcuts →
        </a>
        <a
          href="/mock-test"
          class="px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-xl shadow-xs transition"
        >
          Take 100-Question CCC CBT Test
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
