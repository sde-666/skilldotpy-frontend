---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Free NIELIT O Level & CCC Online Mock Test 2026 (CBT Simulator) | Skilldotpy"
  description="Take free timed online mock tests for NIELIT O Level (M1-R5, M2-R5, M3-R5, M4-R5) and CCC examinations. Real CBT exam pattern, instant marks calculation and Hindi explanations."
  keywords={[
    "NIELIT O Level mock test online free",
    "CCC online test simulator 100 questions",
    "M1-R5.1 online practice test",
    "M3-R5.1 Python MCQ test with answer key",
    "Skilldotpy test series"
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="px-3 py-1 bg-blue-100 text-blue-800 text-xs font-bold rounded-full inline-block mb-3">
        Interactive CBT Practice Engine
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">
        Online Mock Test & Exam Simulator
      </h1>
      <p class="text-xs sm:text-sm text-slate-600">
        Choose your NIELIT examination module and begin your timed practice test.
      </p>
    </div>

    <!-- Test Modules Selector Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs flex flex-col justify-between">
        <div>
          <span class="px-2.5 py-1 bg-blue-50 text-blue-700 text-xs font-bold rounded-md">M1-R5.1</span>
          <h3 class="text-lg font-bold text-slate-900 mt-2 mb-1">IT Tools & Network Basics</h3>
          <p class="text-xs text-slate-500 mb-4">100 MCQs | 90 Minutes | LibreOffice & IT Fundamentals</p>
        </div>
        <button class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl transition">
          Launch M1 Test ⚡
        </button>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs flex flex-col justify-between">
        <div>
          <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-md">M2-R5.1</span>
          <h3 class="text-lg font-bold text-slate-900 mt-2 mb-1">Web Design & Publishing</h3>
          <p class="text-xs text-slate-500 mb-4">100 MCQs | 90 Minutes | HTML5, CSS3, JS & Photo Editing</p>
        </div>
        <button class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition">
          Launch M2 Test ⚡
        </button>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs flex flex-col justify-between">
        <div>
          <span class="px-2.5 py-1 bg-amber-50 text-amber-700 text-xs font-bold rounded-md">M3-R5.1</span>
          <h3 class="text-lg font-bold text-slate-900 mt-2 mb-1">Python Programming</h3>
          <p class="text-xs text-slate-500 mb-4">100 MCQs | 90 Minutes | Core Python & Algorithms</p>
        </div>
        <button class="w-full py-2.5 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-xl transition">
          Launch Python Test ⚡
        </button>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs flex flex-col justify-between">
        <div>
          <span class="px-2.5 py-1 bg-purple-50 text-purple-700 text-xs font-bold rounded-md">M4-R5.1</span>
          <h3 class="text-lg font-bold text-slate-900 mt-2 mb-1">Internet of Things (IoT)</h3>
          <p class="text-xs text-slate-500 mb-4">100 MCQs | 90 Minutes | Sensors, Arduino & Protocols</p>
        </div>
        <button class="w-full py-2.5 bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold rounded-xl transition">
          Launch IoT Test ⚡
        </button>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs flex flex-col justify-between">
        <div>
          <span class="px-2.5 py-1 bg-rose-50 text-rose-700 text-xs font-bold rounded-md">CCC</span>
          <h3 class="text-lg font-bold text-slate-900 mt-2 mb-1">Course on Computer Concepts</h3>
          <p class="text-xs text-slate-500 mb-4">100 MCQs & T/F | 90 Minutes | Full Syllabus Test</p>
        </div>
        <button class="w-full py-2.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold rounded-xl transition">
          Launch CCC Test ⚡
        </button>
      </div>
    </div>
  </div>
</BaseLayout>
