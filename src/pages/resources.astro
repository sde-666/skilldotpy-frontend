---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="NIELIT O Level & CCC Free PDF Notes & Model Papers Download | Skilldotpy"
  description="Download official NIELIT O Level (R5.1) syllabus, chapter-wise PDF notes, previous year question papers, and LibreOffice shortcut cheatsheets for free."
  keywords={[
    "NIELIT O Level PDF notes download free",
    "CCC model question paper pdf",
    "M1-R5.1 syllabus pdf",
    "M3-R5 Python practical solved questions pdf",
    "Skilldotpy PDF downloads"
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">
        Free Study Material & PDF Downloads
      </h1>
      <p class="text-xs sm:text-sm text-slate-600">
        Direct official syllabus PDFs, chapter revision notes, and previous year examination papers.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs">
        <h2 class="font-bold text-lg text-slate-900 mb-2">📄 Official NIELIT O Level Syllabus (R5.1)</h2>
        <p class="text-xs text-slate-600 mb-4 leading-relaxed">
          Official DOEACC scheme document with detailed credit structure, passing formula, theory hours, and practical lab requirements.
        </p>
        <a
          href="/pdf/nielit-o-level-syllabus-r5.1.pdf"
          download
          class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl transition"
        >
          Download Syllabus PDF 📥
        </a>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs">
        <h2 class="font-bold text-lg text-slate-900 mb-2">📄 LibreOffice Master Shortcut Cheat Sheet</h2>
        <p class="text-xs text-slate-600 mb-4 leading-relaxed">
          High-frequency shortcut keys for LibreOffice Writer, Calc, and Impress tested repeatedly in NIELIT CCC and M1-R5.1.
        </p>
        <a
          href="/notes/ccc-ch1-introduction-to-computer-gui-os"
          class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition"
        >
          View Cheat Sheet Online →
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
