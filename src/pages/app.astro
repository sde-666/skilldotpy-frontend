---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Download Skilldotpy Mobile App (Android APK) - Offline Notes & Tests"
  description="Download the official Skilldotpy Android app for offline NIELIT O Level & CCC study notes, MCQ test series, and practical question bank."
  keywords={["Skilldotpy app apk", "NIELIT O level android app", "CCC preparation app Hindi", "Skilldotpy mobile download"]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-white border border-slate-200 rounded-3xl p-8 sm:p-12 shadow-xs text-center">
      <div class="w-16 h-16 bg-blue-600 rounded-2xl text-white font-black text-3xl flex items-center justify-center mx-auto mb-4 shadow-lg">
        S
      </div>
      <span class="px-3 py-1 bg-blue-100 text-blue-800 text-xs font-bold rounded-full inline-block mb-3">Skilldotpy Official Android App</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mb-3">Study NIELIT O-Level & CCC Anywhere</h1>
      <p class="text-sm text-slate-600 max-w-xl mx-auto mb-8 leading-relaxed">
        Get instant access to chapter-wise notes, take timed CBT mock tests with zero internet lag, and ask AI doubts directly from your phone.
      </p>

      <div class="inline-flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://play.google.com/store/apps/details?id=com.skilldotpy.app"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-3.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm rounded-2xl shadow-md transition flex items-center gap-3"
        >
          <span>📱</span> Get it on Google Play
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
