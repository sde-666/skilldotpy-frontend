---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact & Support | Skilldotpy"
  description="Have questions about NIELIT O Level, CCC courses or Skilldotpy notes? Contact Mr. Aditya Pathak and the Skilldotpy team for guidance."
  keywords={["Contact Skilldotpy", "Aditya Pathak email", "NIELIT exam guidance", "Skilldotpy support"]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-white border border-slate-200 rounded-2xl p-8 sm:p-10 shadow-xs">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">Get in Touch with Skilldotpy</h1>
      <p class="text-xs sm:text-sm text-slate-600 mb-8">
        Have questions regarding syllabus, practical projects, or study material? Reach out directly.
      </p>

      <div class="space-y-4">
        <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl flex items-center gap-4">
          <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold">✉️</div>
          <div>
            <span class="text-xs text-slate-500 font-medium block">Official Email</span>
            <a href="mailto:AdityaPathak776@gmail.com" class="text-sm font-bold text-slate-900 hover:text-blue-600">AdityaPathak776@gmail.com</a>
          </div>
        </div>

        <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl flex items-center gap-4">
          <div class="w-10 h-10 rounded-lg bg-red-100 text-red-700 flex items-center justify-center font-bold">▶️</div>
          <div>
            <span class="text-xs text-slate-500 font-medium block">Official YouTube Channel</span>
            <a href="https://youtube.com/@skilldotpy" target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-slate-900 hover:text-red-600">youtube.com/@skilldotpy</a>
          </div>
        </div>

        <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl flex items-center gap-4">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">🌐</div>
          <div>
            <span class="text-xs text-slate-500 font-medium block">Website</span>
            <span class="text-sm font-bold text-slate-900">https://skilldotpy.com</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
